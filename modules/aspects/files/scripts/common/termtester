#!/usr/bin/env zsh

# Daniel Crisman's ANSI color chart from the Bash Prompt HOWTO.
test_text='•••'

print -P "\n         def     40m     41m     42m     43m     44m     45m     46m     47m"

for foreground_label in \
  '    m' '   1m' '  30m' '1;30m' '  31m' '1;31m' '  32m' '1;32m' \
  '  33m' '1;33m' '  34m' '1;34m' '  35m' '1;35m' '  36m' '1;36m' \
  '  37m' '1;37m'; do
  foreground=${foreground_label// /}
  printf ' %s \033[%s  %s  ' "$foreground_label" "$foreground" "$test_text"

  for background in 40m 41m 42m 43m 44m 45m 46m 47m; do
    printf '\033[%s\033[%s  %s  \033[0m' "$foreground" "$background" "$test_text"
  done
  print
done
print

print -P 'Normal'
print -P '\033[1mBold\033[22m'
print -P '\033[3mItalic\033[23m'
print -P '\033[3;1mBold Italic\033[0m'
print -P '\033[4mUnderline\033[24m'
print -P '\033[4:3mCurl\033[4:0m'
print -P '\033[3m\033[4mItalic underline\033[0m'
print -P '\033[3m\033[4:3mItalic curl\033[0m'

print -P '\nFont test:'
print '== === !== >= <= =>'
print '契          勒 鈴 '

print -P '\nTrue color test:'

term_cols=${width:-$(tput cols 2>/dev/null)}
if [[ ! $term_cols == <-> ]] || ((term_cols < 1)); then
  term_cols=80
fi

awk -v term_cols="$term_cols" 'BEGIN {
    s = "/\\"
    for (colnum = 0; colnum < term_cols; colnum++) {
        r = 255 - (colnum * 255 / term_cols)
        g = colnum * 510 / term_cols
        b = colnum * 255 / term_cols
        if (g > 255) {
            g = 510 - g
        }
        printf "\033[48;2;%d;%d;%dm", r, g, b
        printf "\033[38;2;%d;%d;%dm", 255-r, 255-g, 255-b
        printf "%s\033[0m", substr(s, colnum % 2 + 1, 1)
    }
    printf "\n"
}'

print -P '\nCurrent $LS_COLORS:'

typeset -A names
names=(
  no 'global default'
  fi 'normal file'
  di 'directory'
  ln 'symbolic link'
  pi 'named pipe'
  so 'socket'
  do 'door'
  bd 'block device'
  cd 'character device'
  or 'orphan symlink'
  mi 'missing file'
  su 'set uid'
  sg 'set gid'
  tw 'sticky other writable'
  ow 'other writable'
  st 'sticky'
  ex 'executable'
)

for entry in ${(s.:.)LS_COLORS}; do
  key=${entry%%=*}
  color=${entry#*=}
  name=${names[$key]:-$key}
  printf '\033[%sm%s\033[m\n' "$color" "$name"
done
