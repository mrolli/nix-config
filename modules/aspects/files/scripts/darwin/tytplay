#!/bin/bash

# Terminal YouTube player for my YT Deep House playlist
playlist_url="https://www.youtube.com/playlist?list=PLGe3z15K4zd9vc1UITjuGSCMuv0WvwEAt"
data_dir=${XDG_DATA_HOME:-$HOME}/tytplay
playlist_file=$data_dir/playlist.txt

usage() {
  echo "Usage: tytplay [--video] [--purge]"
  echo ""
  echo "Options:"
  echo "  --video     Play videos with video profile"
  echo "  --purge     Purge and refresh the playlist file"
  echo "  --help, -h  Show this help message"
}

for cmd in yt-dlp fzf mpv; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "$cmd not found, please install $cmd." >&2
    exit 1
  fi
done

profile=no-video
purge=false
for arg; do
  case "$arg" in
    --video) profile=secondary-screen ;;
    --purge) purge=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      usage >&2
      exit 1
      ;;
  esac
done

mkdir -p "$data_dir"

if [ "$purge" = true ]; then
  echo "Purging playlist file..."
  rm -f "$playlist_file"
fi

# Create playlist if necessary. Flat extraction only lists entries and
# skips per-video format resolution, which is slow and fragile.
if [ ! -s "$playlist_file" ]; then
  echo -n "Creating playlist file... "
  tmp_file=$playlist_file.tmp
  if yt-dlp --flat-playlist --no-warnings \
    --print '%(title)s' \
    --print '%(thumbnails.-1.url)s' \
    --print '%(url)s' \
    "$playlist_url" >"$tmp_file" && [ -s "$tmp_file" ]; then
    mv "$tmp_file" "$playlist_file"
    echo "done ($(($(wc -l <"$playlist_file") / 3)) entries)."
  else
    rm -f "$tmp_file"
    echo "failed." >&2
    exit 1
  fi
fi

tmpimg=$(mktemp "${TMPDIR:-/tmp}/tytplay_preview.XXXXXX")
trap 'rm -f "$tmpimg"' EXIT

selection=$(awk '
  NR % 3 == 1 { title = $0 }
  NR % 3 == 2 { img = $0 }
  NR % 3 == 0 { url = $0; print title "\t" img "\t" url }
' "$playlist_file" |
  fzf --delimiter='\t' \
    --with-nth=1 \
    --preview="
        if command -v viu >/dev/null 2>&1; then
          curl -sL {2} -o '$tmpimg' && viu -h 20 '$tmpimg'
        else
          echo 'viu not found, please install viu to see image preview.'
        fi
      " \
    --preview-window up:border-none)

[ -n "$selection" ] || exit 0

IFS=$'\t' read -r title _ url <<<"$selection"
echo "$title"
if [ "$profile" = no-video ]; then
  mpv --volume=60 --profile="$profile" --ytdl-format='bestaudio[protocol=m3u8_native]/bestaudio' "$url"
else
  mpv --volume=60 --profile="$profile" "$url"
fi
